{
  "name": "BK-BABU",
  "description": "BK BABU WhatsApp Bot powered by Baileys",
  "logo": "https://raw.githubusercontent.com/babuyour316-ship-it/BK-BABU/main/1790162918643.png",
  "keywords": [
    "BK-BABU",
    "BK-BABU-BOT",
    "WhatsApp Bot",
    "Baileys",
    "Nodejs Bot"
  ],
  "success_url": "/",
  "stack": "heroku-24",

  "env": {
    "DATABASE_URL": {
      "description": "MongoDB or PostgreSQL database URL",
      "required": false
    },

    "OWNER_NUMBER": {
      "description": "Bot owner's WhatsApp number without + sign",
      "value": "",
      "required": true
    },

    "PREFIX": {
      "description": "Command prefix for bot",
      "value": ".",
      "required": false
    },

    "BOT_NAME": {
      "description": "Bot display name",
      "value": "BK-BABU",
      "required": false
    },

    "OWNER_NAME": {
      "description": "Bot owner name",
      "value": "BK BABU",
      "required": false
    },

    "CAPTION": {
      "description": "Footer caption used in bot messages",
      "value": "POWERED BY BK BABU",
      "required": false
    },

    "STATUS_MSG": {
      "description": "Bot auto status message",
      "value": "Hello From BK BABU",
      "required": false
    },

    "NEWSLETTER_JID": {
      "description": "WhatsApp newsletter or channel JID",
      "value": "",
      "required": false
    },

    "MENU_IMG": {
      "description": "Menu image URL",
      "value": "https://raw.githubusercontent.com/babuyour316-ship-it/BK-BABU/main/1790162918643.png",
      "required": false
    },

    "SITE_URL": {
      "description": "Pairing website URL",
      "value": "",
      "required": false
    },

    "PORT": {
      "description": "Server port",
      "required": false
    }
  },

  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ]
}
